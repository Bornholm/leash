FROM golang:1.25-alpine AS builder

WORKDIR /build

RUN apk add --no-cache git

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o leash-server ./cmd/server

FROM alpine:3.21

RUN apk add --no-cache bubblewrap
RUN adduser -D -u 1000 leash
WORKDIR /app

COPY --from=builder /build/leash-server /app/leash-server
COPY --from=builder /build/policies/ /app/policies/
RUN mkdir -p /var/lib/leash/workspaces && chown leash:leash /var/lib/leash/workspaces

VOLUME ["/var/lib/leash/workspaces"]

EXPOSE 8443

ENV LEASH_MCP_LISTEN_ADDR=0.0.0.0:8443
ENV LEASH_WORKSPACE_ROOT=/var/lib/leash/workspaces
USER leash

ENTRYPOINT ["/app/leash-server"]
