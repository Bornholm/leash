# Configuration for the server binary (cmd/server — MCP HTTP Streaming, multi-tenant).
# Copy to .env and fill in real secrets. Never commit the real .env file.

# Required: secret used to HMAC-derive workspace directory names from
# discriminants. Use a long, random, high-entropy value.
LEASH_HMAC_SECRET=

# Required: at least one API key. <NAME> is an arbitrary identifier for the
# key (letters, digits, '_', '-'). The raw value below is the Bearer token
# clients must send: "Authorization: Bearer <value>".
LEASH_APIKEY_DEFAULT=

# Optional: fix the workspace for this key, overriding any header/URL
# discriminant. All requests using this key always land in the same
# workspace.
#LEASH_APIKEY_DEFAULT_WORKSPACE_ID=

# Optional: extra static env vars injected into this key's workspace
# (comma-separated K=V pairs).
#LEASH_APIKEY_DEFAULT_ENV=FOO=bar,BAZ=qux

# Optional: per-key policy file (allowed binaries, builtins, MCP servers,
# and optionally its own sandbox settings). Without this, the key gets the
# hardened default sandbox with all builtins disabled. See docs/mcp-http.md
# for what a key's policy file can and cannot override.
#LEASH_APIKEY_DEFAULT_POLICY=policies/default.yaml

# Optional: root directory under which workspace directories are created.
#LEASH_WORKSPACE_ROOT=./leash-workspaces

# Optional: inactivity TTL before a workspace is reaped (Go duration syntax).
#LEASH_TTL=30m

# Optional: HTTP header / URL variable carrying the tenant discriminant.
#LEASH_DISC_HEADER=X-Workspace
#LEASH_DISC_URL_PARAM=workspace

# Optional: TCP listen address of the HTTP server.
#LEASH_MCP_LISTEN_ADDR=:8443

# Optional: debug log verbosity ("debug", "info", "warn", "error"). Does not
# affect the per-command audit log, which is always on. See docs/mcp-http.md.
#LEASH_LOG_LEVEL=info
